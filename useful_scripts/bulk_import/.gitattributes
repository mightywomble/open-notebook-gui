# Security - Mark sensitive file patterns for git-secrets and similar tools
*.env filter=git-crypt diff=git-crypt
*.key filter=git-crypt diff=git-crypt
*.pem filter=git-crypt diff=git-crypt
*.p12 filter=git-crypt diff=git-crypt
*.pfx filter=git-crypt diff=git-crypt
*.jks filter=git-crypt diff=git-crypt
*_rsa filter=git-crypt diff=git-crypt
*_dsa filter=git-crypt diff=git-crypt
*_ed25519 filter=git-crypt diff=git-crypt
*_ecdsa filter=git-crypt diff=git-crypt
*.ppk filter=git-crypt diff=git-crypt

# Normalize line endings for all text files
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Makefile
Makefile text eol=lf
makefile text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.whl binary
*.egg binary
